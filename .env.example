# SoroForge environment.
#
# Copy to .env and fill in. .env is gitignored — keep it that way.
#
#   cp .env.example .env
#
# Everything secret lives here rather than in soroforge.yaml, so the config file
# stays safe to commit.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string for the deployment history.
# Matches the docker-compose service below.
DATABASE_URL=postgres://soroforge:soroforge@localhost:5432/soroforge?sslmode=disable

# ---------------------------------------------------------------------------
# Deployer key — read the security notes in the README before setting this
# ---------------------------------------------------------------------------
#
# SoroForge reads a key you provide; it does not generate or manage keys. Pick
# ONE of the two options below. If both are set, SOROFORGE_SECRET_KEY wins, so
# CI can override a developer's on-disk key without editing files.
#
# The secret is never logged, never written to the database, and never included
# in --json output. Only the derived public G... address is recorded.

# Option A — environment variable. Convenient in CI, where the value comes from
# the runner's secret store. Avoid this on a workstation: environment variables
# are readable by every child process and tend to end up in shell history.
SOROFORGE_SECRET_KEY=

# Option B — keystore file containing nothing but the seed. Preferred locally,
# because a file can be locked down:
#
#   install -m 600 /dev/null ~/.soroforge/deployer.key
#   printf '%s' 'S...' > ~/.soroforge/deployer.key
#
# SOROFORGE_KEYSTORE_PATH=/home/you/.soroforge/deployer.key

# ---------------------------------------------------------------------------
# HTTP API (only needed for `soroforge serve`)
# ---------------------------------------------------------------------------

# Required to start the server. It refuses to boot without one, because the API
# can deploy and upgrade contracts using the key above. Generate a real value:
#
#   openssl rand -hex 32
SOROFORGE_API_TOKEN=

# Listen address. Defaults to 127.0.0.1:8080 — loopback on purpose, since this
# process holds a signing key. Only widen it behind your own TLS and auth.
# SOROFORGE_API_ADDR=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Override the config file location (default: ./soroforge.yaml).
# SOROFORGE_CONFIG=/etc/soroforge/soroforge.yaml

# Used only by the Postgres integration tests, which skip when it is unset.
# Point it at a throwaway database: the tests truncate tables.
# TEST_DATABASE_URL=postgres://soroforge:soroforge@localhost:5432/soroforge?sslmode=disable
